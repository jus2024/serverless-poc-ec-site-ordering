# ===========================================
# 環境変数テンプレート
# このファイルを .env.local にコピーして使用してください
# 実際の値はコミットしないでください
# ===========================================

# AWS リージョン（Amplify sandbox 用）
# AWS_REGION=us-west-2

# AgentCore Runtime ARN（エージェント機能を使う場合）
# Amplify Hosting ではコンソールの環境変数で設定してください
# NEXT_PUBLIC_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/sample_agent-xxxxxxxxxx

# ===========================================
# 注文パイプライン検証（order-pipeline-poc）
# ===========================================

# 注文 API のベース URL（要件 14.10）
# npx ampx sandbox の出力に表示された API エンドポイントを設定してください
# NEXT_PUBLIC_ORDER_API_URL=https://xxxxxxxxxx.execute-api.us-west-2.amazonaws.com

# -------------------------------------------
# 検証パラメータ（design §10.1）
# 変更後は再デプロイが必要です。未設定の場合は既定値が使われます
# 範囲外の値は合成時に例外となりデプロイが止まります（要件 10.5）
# -------------------------------------------

# DynamoDB Streams のバッチサイズ（既定 1 / 範囲 1〜10000）
# ORDER_STREAM_BATCH_SIZE=1

# シャードあたりの並列処理数（既定 1 / 範囲 1〜10）
# ORDER_STREAM_PARALLELIZATION_FACTOR=1

# レコードの最大保持経過秒数（既定 -1（無期限） / 範囲 -1 または 60〜604800）
# ORDER_STREAM_MAX_RECORD_AGE_SECONDS=-1

# 決済の擬似処理時間（既定 3000 / 範囲 0〜60000、ミリ秒）
# ORDER_PAYMENT_DELAY_MS=3000

# 通知の擬似処理時間（既定 500 / 範囲 0〜60000、ミリ秒）
# ORDER_NOTIFICATION_DELAY_MS=500

# 決済の擬似失敗率（既定 0 / 範囲 0〜1）
# ORDER_PAYMENT_FAILURE_RATE=0

# 注文テーブルの warm throughput（既定 未設定 / 範囲 4000〜1000000）
# 注意: 引き上げ後は下げられず課金が発生します（要件 17.8）
# ORDER_WARM_THROUGHPUT_WRITE=
# ORDER_WARM_THROUGHPUT_READ=

# 検証データの TTL（既定 7 / 範囲 1〜30、日）
# ORDER_DATA_TTL_DAYS=7

# 負荷生成の上限値（暴走防止のガードレール）
# ORDER_MAX_ORDERS_PER_MINUTE=20000   # 既定 20000 / 範囲 1〜100000
# ORDER_MAX_DURATION_SECONDS=3600     # 既定 3600 / 範囲 1〜7200
# ORDER_MAX_MEASURE_CONCURRENCY=200   # 既定 200 / 範囲 1〜1000
